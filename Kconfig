DT_COMPAT_ZMK_BEHAVIOR_SENSOR_ROTATE_KEY_POS := zmk,behavior-sensor-rotate-key-pos
DT_COMPAT_ZMK_BEHAVIOR_MOUSE_SCROLL_STEP := zmk,behavior-mouse-scroll-step

config ZMK_BEHAVIOR_SENSOR_ROTATE_KEY_POS
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_SENSOR_ROTATE_KEY_POS))

config ZMK_BEHAVIOR_MOUSE_SCROLL_STEP
    bool
    depends on ZMK_POINTING
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_MOUSE_SCROLL_STEP))
